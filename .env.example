# Public environment variables
NEXT_PUBLIC_CURRENCY=UGX
NEXT_PUBLIC_CLERK_FRONTEND_API=https://your-clerk-instance.clerk.accounts.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private environment variables
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret
# Dev-only convenience. Keep false in staging/production.
ENABLE_SELF_ADMIN_BOOTSTRAP=false

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=test

INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment gateway. Leave PAYMENT_GATEWAY empty (or omit the keys below) and
# every method stays collect-on-delivery, exactly as before.
# Supported: flutterwave | pesapal
PAYMENT_GATEWAY=flutterwave

# --- Flutterwave (API v4, default gateway) ---
# sandbox | live. v4 has separate hosts AND separate credentials per
# environment, so this switches the base URL. Defaults to sandbox.
FLW_ENV=sandbox
# v4 authenticates with OAuth2 client credentials, not API keys.
# Dashboard -> Settings -> API Keys.
FLW_CLIENT_ID=your_flutterwave_client_id
FLW_CLIENT_SECRET=your_flutterwave_client_secret
FLW_ENCRYPTION_KEY=your_flutterwave_encryption_key
# The "Secret hash" you set on the Flutterwave webhook page, pointed at
# https://<your-domain>/api/webhooks/payments
# Optional while testing: payments work without it, but webhooks are rejected
# as unsigned and orders settle when the shopper returns. Required before live.
FLW_WEBHOOK_HASH=
# Escape hatch to pin a different API host; normally leave empty.
FLW_API_BASE_URL=

# --- Pesapal (API v3, alternative gateway) ---
# sandbox | live. Sandbox uses cybqa.pesapal.com, live uses pay.pesapal.com.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
# Obtained by running: node scripts/registerPesapalIpn.mjs <public-https-url>
# Pesapal rejects every transaction until a notification id is registered, so
# the gateway counts as unconfigured without this.
PESAPAL_IPN_ID=

EMAIL_PROVIDER=resend
EMAIL_ENABLED=false
EMAIL_DEBUG=true
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Wilwa <notifications@yourdomain.com>
EMAIL_REPLY_TO=support@yourdomain.com
APP_BASE_URL=http://localhost:3000

SMS_ENABLED=false
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SMS_FROM=Wilwa
